{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/signup",
      "destination": "/#signup",
      "permanent": false
    },
    {
      "source": "/menu",
      "destination": "https://order.tjskitchenvc.com/menu",
      "permanent": false
    },
    {
      "source": "/john",
      "destination": "/card/john",
      "permanent": false
    },
    {
      "source": "/play",
      "destination": "/play2",
      "permanent": false
    },
    {
      "source": "/play/",
      "destination": "/play2",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(site\\.js|style\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/card/:slug",
      "destination": "/card"
    }
  ]
}
