{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/signup",
      "destination": "/#signup",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/privacy#texting",
      "permanent": false
    },
    {
      "source": "/menu",
      "destination": "https://order.tjskitchenvc.com/menu",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(site\\.js|style\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
